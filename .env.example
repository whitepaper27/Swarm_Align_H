# Copy to .env (gitignored). Never commit real keys.
ANTHROPIC_API_KEY=

# Models — requested IDs are frozen; returned IDs are recorded per call.
ACTOR_MODEL_ID=claude-haiku-4-5-20251001

# Pricing (USD per million tokens) for ACTOR_MODEL_ID. Owner fills from the account's pricing page.
# Unknown/empty pricing => the ledger refuses every live call.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# Spend caps (USD), enforced by reserve-before-dispatch in src/aiv/spend.
SPEND_CAP_TOTAL_USD=50
SPEND_CAP_DISCOVERY_USD=5
SPEND_CAP_PILOT_USD=5
SPEND_CAP_MAIN_USD=25
SPEND_CAP_LIVE_USD=8
SPEND_CAP_CONFIRM_USD=5
# Per-episode caps: provisional (L3 values), confirmed after the pilot.
SPEND_CAP_EPISODE_USD=0.80

# Where the shared ledger + lock live (one per machine, shared by all worktrees).
AIV_SPEND_ROOT=

# Recorder HMAC key (any long random string). Required in live mode; mock uses a public key.
AIV_RECORDER_KEY=
