# Copy to .env (gitignored). Never commit real keys.
ANTHROPIC_API_KEY=

# Models — requested IDs are frozen; returned IDs are recorded per call.
ACTOR_MODEL_ID=claude-haiku-4-5-20251001

# Pricing (USD per million tokens) for ACTOR_MODEL_ID. Owner fills from the account's pricing page.
# Unknown/empty pricing => the ledger refuses every live call.
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# Spend caps (USD), enforced by reserve-before-dispatch in src/aiv/spend.
SPEND_CAP_TOTAL_USD=50
SPEND_CAP_DISCOVERY_USD=5
SPEND_CAP_PILOT_USD=5
SPEND_CAP_MAIN_USD=25
SPEND_CAP_LIVE_USD=8
SPEND_CAP_CONFIRM_USD=5
# Per-episode caps: provisional (L3 values), confirmed after the pilot.
SPEND_CAP_EPISODE_USD=0.80

# Cross-provider extension (sol.md §16, GOAL deviation 7). Strata caps:
SPEND_CAP_XDISCOVERY_USD=2
SPEND_CAP_XLIVE_USD=4
SPEND_CAP_XMAIN_USD=8
SPEND_CAP_XCONFIRM_USD=4
# Keys for --publisher-provider / --worker-provider openai|gemini.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Per-model pricing: PRICE_<KEY>_INPUT/OUTPUT_PER_MTOK, <KEY> = model id uppercased, every
# non-alphanumeric -> "_". The generic PRICE_* above cover only ACTOR_MODEL_ID; any other model
# without both of its own prices is refused by the ledger.
PRICE_GEMINI_3_5_FLASH_LITE_INPUT_PER_MTOK=
PRICE_GEMINI_3_5_FLASH_LITE_OUTPUT_PER_MTOK=
PRICE_GPT_5_4_NANO_2026_03_17_INPUT_PER_MTOK=
PRICE_GPT_5_4_NANO_2026_03_17_OUTPUT_PER_MTOK=
# Keys .env overrides even when already set in the shell (comma-separated), e.g. a stale key:
# AIV_DOTENV_OVERRIDE=OPENAI_API_KEY

# Where the shared ledger + lock live (one per machine, shared by all worktrees).
AIV_SPEND_ROOT=

# Recorder HMAC key (any long random string). Required in live mode; mock uses a public key.
AIV_RECORDER_KEY=
